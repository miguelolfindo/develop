// Windows resources for develop.exe: the icon (the first icon is the one Windows shows)
// and the version details Explorer and Task Manager display.
1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION 0,3,0,0
PRODUCTVERSION 0,3,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Develop"
            VALUE "ProductName", "Develop"
            VALUE "FileVersion", "0.3.0"
            VALUE "ProductVersion", "0.3.0"
            VALUE "OriginalFilename", "develop.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END