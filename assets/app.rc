// Windows resources for develop.exe: the icon (the first icon is the one Windows shows)
// and the version details Explorer and Task Manager display. A template: build.rs fills in
// @ICON@ and the version from Cargo.toml.
1 ICON "@ICON@"

1 VERSIONINFO
FILEVERSION @COMMAS@
PRODUCTVERSION @COMMAS@
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Develop"
            VALUE "ProductName", "Develop"
            VALUE "FileVersion", "@VERSION@"
            VALUE "ProductVersion", "@VERSION@"
            VALUE "OriginalFilename", "develop.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END